{
  "crons": [
    {
      "path": "/api/publish",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/purge-trash",
      "schedule": "0 4 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/dashboard.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/dashboard.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
