AIRTABLE_TOKEN=pat_xxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=apphVqbUQohAMIoWk
AIRTABLE_TABLE_ID=tblir7vlazMo8v532

# İlk aşamada kapalı kalacak. Meta API bağlanınca doldurulacak.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=

# Meta Reklamlar paneli (/api/meta-ads/*) — bu panel Meta Graph API'ye DOĞRUDAN
# bağlanmaz, ayrı bir MCP servisine (instagram-Facebook-connect /
# "buzsu-social-connect", Render'da barındırılır) konuşur. META_CONNECT_URL o
# servisin kök adresidir (örn. https://buzsu-social-connect.onrender.com).
# META_CONNECT_MCP_PATH_SECRET, o serviste MCP_PATH_SECRET olarak tanımlanan
# AYNI değerdir — istek URL'sinin path'ine gömülür (/mcp/<secret>). Boş
# bırakılırsa "Meta Reklamlar" ekranı yüklenemez, panelin diğer bölümleri
# etkilenmez.
META_CONNECT_URL=
META_CONNECT_MCP_PATH_SECRET=
# Boş bırakılırsa src/lib/config.js'teki güncel varsayılan sürüm kullanılır.
# Meta sürümleri ~2 yılda bir sonlandırıyor; periyodik olarak yükseltin.
META_GRAPH_VERSION=v25.0
SOCIAL_POST_LIMIT=1
MAX_PUBLISH_ATTEMPTS=3
ENABLE_LIVE_POSTING=false
ENABLE_FACEBOOK_STORIES=false
STORY_IMAGE_BASE_URL=https://your-vercel-project.vercel.app/api/story-image
SCHEDULE_TIME_ZONE=Europe/Istanbul
CRON_SECRET=generate-a-long-random-secret

# YouTube Shorts (videos.insert ile "Reel" formatındaki videolar otomatik
# Shorts olarak sınıflandırılır). Kurulum: Google Cloud Console'da bir OAuth
# Client ID (Web application) oluşturup redirect URI olarak
# https://buzsu-social-publisher.vercel.app/api/youtube-callback ekleyin,
# YOUTUBE_CLIENT_ID/YOUTUBE_CLIENT_SECRET'i Vercel Production'a ekleyip
# deploy edin, sonra panelde oturum açıkken /api/youtube-auth'u (veya
# dashboard'daki "Platform bağlantıları" panelindeki "Bağlan / Yeniden
# bağlan" linkini) ziyaret edin — /api/youtube-callback size bir refresh
# token gösterecek, onu YOUTUBE_REFRESH_TOKEN olarak ekleyin. Google Cloud
# Console'da OAuth consent screen "Testing" durumundaysa refresh token 7
# günde bir otomatik geçersiz olur ("Token has been expired or revoked" hatası)
# — kalıcı kullanım için consent screen'i "In production"a alın.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CATEGORY_ID=22

# Yayın başarısız olduğunda (maksimum deneme sayısına ulaşma dahil) tek
# satırlık bildirim göndermek için opsiyonel bir webhook — Slack Incoming
# Webhook URL'i veya {"text": "..."} gövdesini kabul eden herhangi bir
# endpoint (örn. n8n/Make webhook, kendi Telegram/e-posta köprünüz).
# Tanımlı değilse bildirim gönderilmez, yayın akışı etkilenmez.
ALERT_WEBHOOK_URL=

# AI Reels üretimi (en az bir sağlayıcı eklenebilir; anahtarlar Vercel Production'da tutulur)
OPENAI_API_KEY=
OPENAI_REEL_MODEL=gpt-5.6
OPENAI_SCENE_MODEL=gpt-image-1
# Creative tier overrides must name a model returned by provider discovery.
# No tier silently falls back to another tier or paid model.
OPENAI_CREATIVE_ECONOMY_MODEL=
OPENAI_CREATIVE_BALANCED_MODEL=
OPENAI_CREATIVE_QUALITY_MODEL=
OPENAI_CREATIVE_PREMIUM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_REEL_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_REEL_MODEL=gemini-3.5-flash
GEMINI_SCENE_MODEL=gemini-3.1-flash-lite-image
# generate_scene_image economy/balanced/quality tier'ları (TASK-003) —
# opsiyonel override'lar. GEMINI_SCENE_MODEL yukarıdaki "economy" (Nano
# Banana 2 Lite) tier'ının modelidir. Boş bırakılırsa balanced/quality
# sırasıyla "gemini-3.1-flash-image"/"gemini-3-pro-image" kullanır.
# GEMINI_NANO_BANANA_PRO_MODEL ("quality") gerçek discovery'de bu hesapta
# bulunamazsa generate_scene_image SESSİZCE balanced'a düşmez, açık bir
# hata döner — bkz. README.md "economy/balanced/quality kalite tier'ları".
GEMINI_NANO_BANANA_2_MODEL=
GEMINI_NANO_BANANA_PRO_MODEL=
GOOGLE_CREATIVE_ECONOMY_MODEL=
GOOGLE_CREATIVE_BALANCED_MODEL=
GOOGLE_CREATIVE_QUALITY_MODEL=
GOOGLE_CREATIVE_PREMIUM_MODEL=
# research_web / generate_reel_script researchMode (TASK-001) — opsiyonel.
# Boş bırakılırsa GEMINI_REEL_MODEL/OPENAI_REEL_MODEL (onlar da yoksa sabit
# bir varsayılan) kullanılır. GOOGLE_API_KEY/OPENAI_API_KEY reuse edilir,
# ayrı bir key GEREKMEZ. OPENAI_WEB_SEARCH_TOOL_TYPE, OpenAI Responses
# API'sinin web arama tool adı değişirse (ör. "web_search_preview") sessizce
# eski adda kalınmaması için override edilebilir.
GOOGLE_RESEARCH_MODEL=
OPENAI_RESEARCH_MODEL=
OPENAI_WEB_SEARCH_TOOL_TYPE=
# transcribe_media (TASK-002) — opsiyonel. Boş bırakılırsa GOOGLE_TRANSCRIBE_MODEL
# "gemini-3.5-transcribe", OPENAI_TRANSCRIBE_MODEL diarization:true İSTENMEDİYSE
# "whisper-1", İSTENDİYSE otomatik "gpt-4o-transcribe-diarize" olur. Verilen
# model GERÇEK bir /models discovery çağrısında bulunamazsa (ör. hesabınızda
# henüz yoksa) SESSİZCE başka bir modele düşülmez, açık bir hata döner —
# bkz. README.md "transcribe_media". GEMINI_API_KEY/OPENAI_API_KEY reuse
# edilir, ayrı bir key GEREKMEZ.
GOOGLE_TRANSCRIBE_MODEL=
OPENAI_TRANSCRIBE_MODEL=
# validate_product_visual (TASK-004) — opsiyonel. Boş bırakılırsa
# "gemini-3.5-flash" kullanılır. GEMINI_API_KEY reuse edilir, ayrı bir key
# GEREKMEZ — bkz. README.md "validate_product_visual".
GEMINI_VISUAL_VALIDATION_MODEL=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=v1
REEL_RENDER_CALLBACK_URL=
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/minimax-video/image-to-video

# AI sahne görselini kalıcı bir URL'e yükleyip içerik kuyruğuna bağlamak için
# (opsiyonel; Vercel projesinde bir Blob store bağlayınca otomatik eklenir).
# Tanımlı değilse "Sahne üret" yalnızca önizleme gösterir, kuyruğa eklenemez.
BLOB_READ_WRITE_TOKEN=

# buzsu.com.tr'nin GA4 mülkünden site analitiği (en çok görüntülenen ürünler,
# aktif ziyaretçi, varsa sepete ekleme) okumak için — opsiyonel, tanımlı
# değilse "Site Analitiği" paneli sessizce "bağlı değil" gösterir. GA4_PROPERTY_ID
# Google Analytics > Yönetici > Mülk Ayarları'nda görünür. GA4_CLIENT_EMAIL ve
# GA4_PRIVATE_KEY, Google Cloud Console'da oluşturulan ve GA4 mülküne
# "Görüntüleyici" olarak eklenen bir servis hesabının JSON anahtarından gelir.
GA4_PROPERTY_ID=289526828
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# compose_product_video (ücretsiz FFmpeg + GitHub Actions render kuyruğu,
# bkz. src/video-compose.js). GITHUB_DISPATCH_TOKEN, bu depoda
# "Actions: write" izni olan bir GitHub personal access token'dır (fine-grained
# PAT önerilir) — .github/workflows/render-product-video.yml'i workflow_dispatch
# ile tetiklemek için kullanılır. Boş bırakılırsa compose_product_video hata
# döner. Render worker'ın (GitHub Actions runner'ı) kendisi de Vercel Blob'a
# yazabilmek için AYRICA bu depoda "BLOB_READ_WRITE_TOKEN" adında bir GitHub
# Actions secret'ı olarak tanımlanmalı (Vercel'deki değerle aynı).
GITHUB_DISPATCH_TOKEN=
# Boş bırakılırsa src/lib/config.js'teki varsayılanlar (gumustasas/buzsu-social-publisher,
# main, render-product-video.yml) kullanılır — yalnızca bir fork/farklı repo'da
# çalıştırılıyorsa override edin.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
VIDEO_RENDER_REF=
VIDEO_RENDER_WORKFLOW_FILE=

# compose_product_video'nun OPSİYONEL, ÜCRETLİ görsel büyütme adımı
# (upscaleImages:true, bkz. src/lib/image-upscale.js). Düşük çözünürlüklü
# ürün fotoğraflarını (site thumbnail'ı gibi) Ken Burns animasyonundan ÖNCE
# Replicate/Real-ESRGAN ile AI büyütür — replicate.com/account/api-tokens
# adresinden alınır. Boş bırakılırsa upscaleImages hata döner (varsayılan
# davranışı ETKİLEMEZ — bu adım yalnızca açıkça istendiğinde çalışır).
# Render worker'ın (GitHub Actions runner'ı) bu değere erişebilmesi için
# AYRICA bu depoda "REPLICATE_API_TOKEN" adında bir GitHub Actions secret'ı
# olarak tanımlanmalı (bkz. .github/workflows/render-product-video.yml).
REPLICATE_API_TOKEN=
